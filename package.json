{
  "name": "runtrail",
  "version": "1.41.3",
  "description": "Self-hosted agent activity ledger",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx src/smoke.ts",
    "conformance": "tsx src/conformance.ts",
    "lint": "biome check . && knip",
    "format": "biome check --write .",
    "release": "semantic-release",
    "cli": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "mcp:bridge": "tsx src/mcp/bridge.ts"
  },
  "bin": {
    "rt": "dist/cli/index.js",
    "runtrail-codex-hook": "dist/integrations/codexHook.js",
    "runtrail-mcp": "dist/mcp/index.js",
    "runtrail-mcp-bridge": "dist/mcp/bridge.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "hono": "^4.13.8",
    "nanoid": "^6.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "knip": "^6.37.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
